{
  "client_id": "${ATTESTER_CLIENT_ID}",
  "client_id_alias": "${ATTESTER_CLIENT_ALIAS}",
  "redirect_uris": [
    "${REDIRECT_URI}"
  ],
  "response_types": [
    "code"
  ],
  "grant_types": [
    "authorization_code",
    "refresh_token",
    "client_credentials"
  ],
  "scope": "openid profile email account",
  "client_name": "${ATTESTER_CLIENT_NAME}",
  "token_endpoint_auth_method": "attest_jwt_client_auth",
  "application_type": "native",
  "extension": {
    "client_attestation_trust_source": "attester_jwks",
    "client_attestation_attester_jwks": "${ATTESTER_JWKS_CONTENT}"
  }
}
